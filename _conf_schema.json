  "interaction_settings": {
    "type": "object",
    "description": "交互与有效期",
    "hint": "菜单有效期、重复打开限制及点击防抖，适用于全局与 UMO 菜单",
    "items": {
      "menu_timeout_seconds": {
        "type": "int",
        "description": "菜单有效期（秒）",
        "hint": "超过该时间后，表情点击和文字选择均不再触发此菜单",
        "default": 60
      },
      "debounce_seconds": {
        "type": "int",
        "description": "点击防抖间隔（秒）",
        "hint": "同一个用户对同一个 emoji 的重复点击冷却时间",
        "default": 3
      },
      "menu_repeat_block": {
        "type": "bool",
        "description": "是否启用菜单冷却阻断",
        "hint": "同一会话中同一菜单未过期时，重复打开只回复提示；不同菜单可分别打开",
        "default": true
      },
      "menu_repeat_reply": {
        "type": "string",
        "description": "菜单冷却时的回复提示",
        "hint": "当菜单被冷却阻断时，机器人会回复该文本",
        "default": "当前菜单已经生效，正在冷却中，直接点表情或发序号/内容即可触发~"
      }
    }
  },
  "appearance_settings": {
    "type": "object",
    "description": "菜单外观",
    "hint": "所有菜单共用的头图、分割线及底部说明",
    "items": {
      "menu_header_image_url": {
        "type": "string",
        "description": "菜单头图 URL",
        "hint": "支持可访问的图床链接，可为空不显示头图",
        "default": ""
      },
      "menu_divider_char": {
        "type": "string",
        "description": "菜单分割线字符",
        "hint": "用于菜单文本中的分割线，例如 '─' 或 '-'",
        "default": "─"
      },
      "menu_divider_length": {
        "type": "int",
        "description": "菜单分割线长度",
        "hint": "控制分割线的长度，建议 20-40 之间",
        "default": 28
      },
      "menu_footer_text": {
        "type": "string",
        "description": "菜单底部说明",
        "hint": "显示在菜单最下方的说明文字；留空则不显示",
        "default": "👆 下方按顺序贴表情，第1个表情对应第1项，第2个表情对应第2项。也可直接回复序号或菜单内容触发。"
      }
    }
  },
  "reaction_settings": {
    "type": "object",
    "description": "表情设置",
    "hint": "自动贴表情的数量限制与备用表情池，适用于所有菜单",
